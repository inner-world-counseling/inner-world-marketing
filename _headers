/*
  X-Robots-Tag: all

# Keep the 404 page out of the index. The /* rule above sets "all", which would
# otherwise contradict the <meta name="robots" content="noindex"> in 404.html.
/404.html
  X-Robots-Tag: noindex

/images/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
